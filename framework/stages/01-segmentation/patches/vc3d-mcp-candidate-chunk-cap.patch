+int maxCandidateChunks()
+{
+    // Candidate discovery reads one Zarr chunk at a time; this cap bounds
+    // server work while permitting a radius-128 cube that spans 3x3x3 m7
+    // chunks.  The historical cap of eight rejected valid broad probes.
+    constexpr int kDefault = 27;
+    constexpr int kAbsoluteMaximum = 27;
+    const char* raw = std::getenv("VC_MCP_MAX_SEED_CANDIDATE_CHUNKS");
+    if (raw == nullptr || *raw == '\0')
+        return kDefault;
+    char* end = nullptr;
+    errno = 0;
+    const long parsed = std::strtol(raw, &end, 10);
+    require(errno == 0 && end != raw && *end == '\0' && parsed >= 1 && parsed <= kAbsoluteMaximum,
+            "VC_MCP_MAX_SEED_CANDIDATE_CHUNKS must be an integer from 1 through 27");
+    return static_cast<int>(parsed);
+}
