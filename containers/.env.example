# Copy to docker/.env locally; do not commit docker/.env.
# All images must be immutable OCI references (repo@sha256:<64 hex chars>).
HELENA_REPO_ROOT=/absolute/path/to/Helena Framework
HELENA_INPUT_ROOT=/absolute/path/to/immutable-input-snapshot
HELENA_MODEL_ROOT=/absolute/path/to/read-only-model-snapshot
HELENA_RUN_OUTPUT=/absolute/path/to/runs/20260720T000000Z-example

HELENA_ORCHESTRATOR_IMAGE=registry.example.invalid/helena-orchestrator@sha256:REPLACE_WITH_64_HEX_DIGEST
# One image backs vc3d-grow, ink-inference, qc and high-recall: helena-gpu-runtime
# carries both the VC3D binaries and the frozen TimeSformer environment, because
# one worker runs the phases that need either. It replaced HELENA_VC3D_IMAGE,
# HELENA_INK_IMAGE and HELENA_QC_IMAGE, which named images that no longer exist
# under those names.
HELENA_GPU_RUNTIME_IMAGE=registry.example.invalid/helena-gpu-runtime@sha256:REPLACE_WITH_64_HEX_DIGEST

HELENA_CONTAINER_UID=1000
HELENA_CONTAINER_GID=1000
HELENA_TMPFS_SIZE=8g
HELENA_VIEWER_BIND=127.0.0.1
HELENA_VIEWER_PORT=8780
HELENA_SCROLLFIESTA_NETWORK_MODE=bridge
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Framework release label for locally built images. Production manifests must
# still pin each image by immutable digest.
HELENA_VERSION=0.2.0
