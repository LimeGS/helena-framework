# /etc/helena/ink.env -- root:root 0600.
#
# Read twice: by systemd to expand the mounts in the unit, and by the container
# as its own environment. CX_DB is the one value the worker reads directly.

HELENA_INK_IMAGE=helena-ink-worker:local
HELENA_INK_REPO=/srv/helena/framework
HELENA_INK_RUNS=/ssd/campaignx/runs
# Where the ink checkpoints live. Mounted read-only at /models; a P5 job names
# the one it wants inside there.
HELENA_INK_MODELS=/srv/helena/models
# Where vc_render_tifxyz stages the volume chunks it streams. Mounted at the
# same path inside the container so a path recorded in a job's command means the
# same thing on the host.
HELENA_INK_CACHE=/srv/helena/cache
# Use the panel stack's named volume by default. Set a host path here only when
# the panel mounts that same path as HELENA_ARTIFACTS.
HELENA_INK_ARTIFACTS=helena-artifacts
HELENA_INK_HOST_ID=this-machine
HELENA_INK_POLL_SECONDS=10
HELENA_INK_JOB_TIMEOUT=21600

# S3 credentials, for P4 fetching the sheet P3 published. A tmpfs path here
# means the unit refuses to start after a reboot; /etc/helena/ink-aws.env
# survives one.
HELENA_INK_AWS_ENV=/dev/shm/campaign-x-gari-aws.env

# The control plane. The worker takes --dsn, defaulting to this.
CX_DB=postgresql://REPLACE
