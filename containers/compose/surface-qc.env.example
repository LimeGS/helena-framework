# /etc/helena/surface-qc.env -- root:root 0600.
#
# Read twice: by systemd to expand the paths in the unit, and by the container
# as its own environment. That is why host paths and in-container paths both
# appear here; the ones ending _HOST or naming a mount are systemd's.

# --- what runs -------------------------------------------------------------
HELENA_QC_IMAGE=helena-gpu-runtime:0.1.1
HELENA_QC_RELEASE=/srv/helena/framework
HELENA_QC_RUN_ROOT=/srv/helena/runs/surface-qc-v2
# Where a locally-published surface actually lives on this host.
# The same named volume the segment stack publishes into, mounted whole at
# /artifacts. It was a host path to that volume's surfaces subdirectory,
# which is one agreement too many: when segment moved to the volume, QC
# kept reading a bind nobody wrote to.
HELENA_QC_ARTIFACTS=helena-artifacts
# P8's locally-published merged surfaces. QC only reads this tree.
HELENA_QC_RECONSTRUCTIONS=/srv/helena/artifacts/reconstruction-v1

# --- secrets, mounted rather than copied -----------------------------------
HELENA_QC_POSTGRES_ENV=/srv/helena/control-plane/postgres.env
# S3 credentials for the evidence upload. A tmpfs path here means QC stops
# working at the next reboot; /etc/helena/qc-aws.env survives one.
# Optional, and off by default: credentials live in the control plane. This
# named a path on the fleet it was written on, so the stack would not start
# anywhere else.
#HELENA_QC_AWS_ENV=/path/to/aws.env

# --- the two inputs that decide a verdict ----------------------------------
# Both are hash-pinned in the ledger. Changing either without changing
# SURFACE_QC_PROFILE_ID makes two incomparable verdicts share a name.
# The path the weights registry installs it at, which is also this compose
# file's own default. The template said /models/model.safetensors -- one file
# bind-mounted, which is how this fleet had it -- so the deploy fetched the
# checkpoint to the registry's path and the worker looked somewhere else and
# restarted forever with the file plainly on the volume.
#
# HELENA_QC_CHECKPOINT_HOST was a path on that fleet's disk and is not needed
# when the models volume is used, which is the default everywhere else.
HELENA_QC_CHECKPOINT=/models/timesformer_GP_scroll1/model.safetensors
HELENA_QC_PROFILE=/workspace/campaign-x/framework/profiles/04-validation/surface-qc-gp-scroll1-ct-fiber-v3-1.0.0.json
# The sha256 of the profile file named above, and the worker refuses to run
# when they differ -- a verdict has to name the profile that produced it, and
# a profile edited without a version bump makes two incomparable verdicts
# share a name. That check works; this value had gone stale, so on a clean
# machine surface QC was BLOCKED_CONFIGURATION forever and P3 then found no
# admissible surface to flatten. Kept in step by a test rather than by memory.
HELENA_QC_PROFILE_SHA256=e0e099eac347f4c590f4428dc361be8bdb5432ccb5b791c2801f131d0eaa4793
SURFACE_QC_PROFILE_ID=surface-qc-gp-scroll1-ct-fiber-v3@1.0.0

# --- inside the container ---------------------------------------------------
HELENA_REPO_ROOT=/workspace/campaign-x
FLEET_DB=postgres-env://SEGMENT_FLEET_DATABASE_URL
SEGMENT_FLEET_POSTGRES_ENV_FILE=/run/secrets/postgres.env
SEGMENT_FLEET_POSTGRES_HOST=127.0.0.1
SEGMENT_FLEET_POSTGRES_PORT=55432
QC_RUN_ROOT=/artifacts/qc-runtime
SURFACE_QC_EXECUTABLE=/workspace/campaign-x/framework/stages/04-validation/scripts/campaignx_surface_qc_adapter.py
HELENA_QC_RENDERER=/opt/campaignx/vc3d/bin/vc_render_tifxyz
# Where QC evidence is written. A local path under the run root by default,
# because object storage is optional and off: the template shipped
# s3://your-bucket/segment-qc-v1, a placeholder that reaches a running
# deployment and fails as FileNotFoundError -- and the error is scrubbed to
# `<path>` before it is recorded, so the job says RETRYABLE_QC_UNAVAILABLE
# and retries every five minutes without ever naming what is missing.
# Measured on a rented 5090, where the whole P0-P7 chain waited on it.
#
# Set an s3:// prefix here when there is a bucket to write to.
HELENA_QC_EVIDENCE_ROOT=/artifacts/qc-runtime/evidence
HELENA_QC_BATCH_SIZE=128
HELENA_QC_DEVICE=cuda
QC_WORKER_ID=this-machine-surface-qc
QC_IDLE_SECONDS=20
QC_TIMEOUT_SECONDS=7200
QC_LEASE_SECONDS=1800
QC_RETRY_DELAY_SECONDS=300
# Stamped on every verdict. Set by the installer from the deployed commit;
# a verdict whose code cannot be identified cannot be reproduced.
HELENA_QC_CODE_COMMIT=unknown
