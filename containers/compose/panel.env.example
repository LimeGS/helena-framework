# /etc/helena/panel.env -- the panel stack's optional overrides.
#
# platform.compose.yaml reads this file if it exists and starts without it if it
# does not. Everything here is a deployment saying it wants something other than
# the default; a single-machine install needs none of it.
#
# It used to live under containers/systemd/ and say "read by systemd to expand
# the mounts", which was the last trace of a deployment shape this platform does
# not use: nothing on a host runs outside a container.
#
# Every CX_* name is documented in the panel's own Configuration page, which is
# also where they can be set without touching this file.
#
# Nothing below is uncommented on purpose. This file shipped four stores
# pointing at s3://REPLACE/... and a CX_DB of postgresql://REPLACE, which a
# clean install copied into place and then failed on -- a placeholder that
# nothing replaces is worse than an absent line, because the deployment looks
# configured.

# ---------------------------------------------------------------- the stack
# The image, when it is not the version compose defaults to.
#   HELENA_PANEL_IMAGE=helena-panel:0.24.0
# The port the panel listens on. 8800 unless something else has it.
#   HELENA_PANEL_PORT=8800
# One directory: accounts, settings overrides, their version history, cache.
# The image holds no state, so this is the whole backup. A named volume by
# default; a host path here if it belongs on a particular disk.
#   HELENA_PANEL_STATE=/srv/helena/panel-state
# Missions. Mounted at the same path inside, so a path in a record means the
# same thing on the host as in the container.
#   HELENA_PANEL_RUNS=/ssd/campaignx/runs

# ------------------------------------------------------------- the settings
# The control plane. compose composes this from POSTGRES_* and the panel needs
# no line here; set it only to point at a database compose did not start.
#   CX_DB=postgresql://user:password@127.0.0.1:55432/campaignx
#
# Where each phase publishes. All four default to the artifact volume the
# platform mounts, so a deployment stores everything itself and needs no bucket
# and no credentials to be complete. Point them at s3:// only when there is a
# real bucket and the credentials are set under Configuration -- and then give
# a real bucket name, not a placeholder.
#   CX_FLATTEN_STORE=s3://your-bucket/flattened-v1
#   CX_RENDER_STORE=s3://your-bucket/layer-stacks-v1
#   CX_INK_STORE=s3://your-bucket/ink-maps-v1
#   CX_RECONSTRUCTION_STORE=s3://your-bucket/reconstruction-v1
