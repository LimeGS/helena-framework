# /etc/helena/platform.env -- root:root 0600.
#
# Read by `docker compose --env-file`, which expands it into the compose file.
# The panel's own settings stay in /etc/helena/panel.env; this file is only what
# compose needs to place the two containers.

HELENA_POSTGRES_IMAGE=postgres:16-alpine
# The credentials file postgres reads: POSTGRES_USER, POSTGRES_DB, POSTGRES_PASSWORD.
HELENA_POSTGRES_ENV=/srv/helena/control-plane/postgres.env
# The database itself. Recreating the container never touches this.
HELENA_POSTGRES_DATA=/srv/helena/postgres-data
# Every worker's DSN names this port. Changing it is a fleet-wide migration.
HELENA_POSTGRES_PORT=55432

HELENA_PANEL_IMAGE=helena-panel:latest
HELENA_PANEL_ENV=/etc/helena/panel.env
HELENA_PANEL_STATE=/srv/helena/panel-state
HELENA_PANEL_RUNS=/ssd/campaignx/runs
HELENA_PANEL_PORT=8800
