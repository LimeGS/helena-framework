# config/platform.env -- 0600, git-ignored, seeded by the deploy from this file.
#
# Read by `docker compose --env-file`, which expands it into
# containers/compose/platform.compose.yaml. It places the platform's containers;
# the panel's own settings live in config/panel.env.

HELENA_POSTGRES_IMAGE=postgres:16-alpine
# The credentials file postgres reads: POSTGRES_USER, POSTGRES_DB, POSTGRES_PASSWORD.
# The deploy writes config/postgres.env and points this at it.
#HELENA_POSTGRES_ENV=/path/to/postgres.env
# The database itself. Recreating the container never touches this.
HELENA_POSTGRES_DATA=/srv/helena/postgres-data
# Every worker's DSN names this port. Changing it is a fleet-wide migration.
HELENA_POSTGRES_PORT=55432

HELENA_PANEL_IMAGE=helena-panel:latest
# The panel's settings. Defaults to config/panel.env next to this file; the
# deploy sets it there when the value names no file.
#HELENA_PANEL_ENV=/path/to/panel.env
HELENA_PANEL_STATE=/srv/helena/panel-state
HELENA_PANEL_RUNS=/ssd/campaignx/runs
HELENA_PANEL_PORT=8800

# Backups. Off unless HELENA_BACKUP_S3 names an s3:// prefix; then the deploy
# starts helena-backup, which every interval (and once at start) uploads a
# pg_dump of the control plane, a tar of the panel state and a tar of runs,
# each with a receipt. Credentials come from an env file the container reads,
# not from the panel: config/aws.env with AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_DEFAULT_REGION and, for anything but AWS, AWS_ENDPOINT_URL. Never write a
# key into this file. Retention is the bucket's lifecycle rule; the script only
# uploads. See the Handbook, Operations -> Backups and object storage.
#HELENA_BACKUP_S3=s3://your-bucket/helena
#HELENA_AWS_ENV=/path/to/aws.env
#HELENA_BACKUP_INTERVAL_HOURS=24
