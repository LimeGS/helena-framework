# /etc/helena/segment.env -- root:root 0600.
#
# Read by `docker compose --env-file` for the segmentation stack. There was no
# example for this file while deploy-platform.sh refused to run without it, so
# the only way to learn its contents was to read the compose or to already have
# a host that worked.
#
# Every variable below has a default in segment.compose.yaml except the first.
# What is written here is what this host does differently.

# Required, and the only one. Which host this is, in the fleet's own terms: it
# goes in the receipts and in the worker's claim, so two machines sharing an id
# claim each other's work and no receipt can say which one ran.
HELENA_SEGMENT_HOST_ID=changeme-hostname

# Where the control plane is. Same DSN every worker uses, and the port is a
# fleet-wide decision rather than a local one.
FLEET_DB=postgresql://campaignx:CHANGEME@10.0.0.1:55432/campaignx

# The phases this host's fleet-runner will claim. Narrow it to keep a machine
# off work it cannot do -- a host with no card should not be claiming P5.
HELENA_FLEET_RUNNER_PHASES=P1,P2,P3,P8

# Where runs and artifacts land on this host. Both want real disk: a run is
# hundreds of megabytes and a worker is meant to be disposable, so anything
# left only here is lost with the machine.
HELENA_FLEET_RUNS=/srv/helena/runs
HELENA_SEGMENT_ARTIFACTS=/srv/helena/artifacts

# The uid:gid the containers run as. The volumes have to be owned by it; the
# platform compose has a prepare-volumes step that does this for a fresh
# install, and this stack expects the directories above to exist already.
HELENA_RUN_AS=1000:1000

# Object storage credentials do NOT belong here.
#
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# AWS_DEFAULT_REGION, AWS_REGION and AWS_ENDPOINT_URL are set on the panel,
# under Configuration, and held in the control plane where every worker already
# looks. A worker is ephemeral: it has to be able to start from a database URL
# and nothing else, which a key placed by hand on each machine cannot give it.
#
# Setting one here does not add to that, it replaces it: the environment wins
# over the control plane, deliberately, so an operator exporting a key for one
# run gets the key they meant. The cost is that a value here makes the panel's
# copy inert while the page still reports it as set. The worker says so on
# startup when it happens, but the shortest path is to leave these unset.
