# syntax=docker/dockerfile:1.7
# The OS base and the VC3D runtime are separate immutable inputs.  The base is
# supplied by digest; the named BuildKit context ``vc3d_runtime`` contains
# exactly one relocatable ``vc3d-runtime.tgz`` produced by the Stage 01 bundle
# builder.  CT, m7, models, credentials and run outputs never enter this image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

ARG BUILD_COMMIT=unknown
ARG SOURCE_DATE_EPOCH=0
ARG FRAMEWORK_VERSION=0.4.1
LABEL org.opencontainers.image.title="helena-vc3d" \
      org.opencontainers.image.description="Helena Framework VC3D/m7 geometry and CT-render runtime contract" \
      org.opencontainers.image.revision="${BUILD_COMMIT}" \
      org.opencontainers.image.version="${FRAMEWORK_VERSION}" \
      org.opencontainers.image.created="${SOURCE_DATE_EPOCH}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CAMPAIGN_X_STAGE=vc3d \
    CAMPAIGN_X_REPO=/workspace/campaign-x \
    CAMPAIGN_X_ARTIFACTS=/artifacts \
    VC3D_RUNTIME_ROOT=/opt/campaignx/vc3d \
    VC3D_GROW_BINARY=/opt/campaignx/vc3d/bin/vc_grow_seg_from_seed \
    VC_MCP_SERVER_BINARY=/opt/campaignx/vc3d/bin/vc_mcp_server \
    VC3D_RENDER_BINARY=/opt/campaignx/vc3d/bin/vc_render_tifxyz \
    VC_MCP_GROW_EXECUTABLE=/opt/campaignx/vc3d/bin/vc_grow_seg_from_seed \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PATH=/opt/campaignx/vc3d/bin:${PATH}

# The minimal Ubuntu base does not include a trust store. VC3D reads public
# HTTPS Zarr sources directly, so a missing CA bundle otherwise appears as the
# misleading runtime error `HTTP 0 fetching .zattrs`.
#
# This layer previously ran a bare `apt-get install ca-certificates`, which
# resolves to whatever the distribution mirror serves at build time. Two builds
# of the same commit against the same digest-pinned base therefore produced
# different images. The version is now an explicit build argument with no
# default: an unpinned build fails instead of silently floating.
#
# Find the value for a given base with:
#   docker run --rm "$VC3D_BASE_IMAGE" sh -c \
#     'apt-get update >/dev/null 2>&1 && apt-cache policy ca-certificates'
# and record it in base-images.env next to the base digest, because the correct
# version is a property of the base image, not of this file.
ARG CA_CERTIFICATES_VERSION
RUN test -n "${CA_CERTIFICATES_VERSION}" || { \
      echo "CA_CERTIFICATES_VERSION build-arg is required; an unpinned apt layer is not reproducible" >&2; \
      exit 2; \
    } \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates="${CA_CERTIFICATES_VERSION}" \
 && dpkg-query --showformat='${Version}' --show ca-certificates \
      | grep -Fxq "${CA_CERTIFICATES_VERSION}" \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=vc3d_runtime /vc3d-runtime.tgz /tmp/vc3d-runtime.tgz

RUN mkdir -p /opt/campaignx/vc3d \
 && tar -xzf /tmp/vc3d-runtime.tgz -C /opt/campaignx/vc3d \
 && test "$(cat /opt/campaignx/vc3d/BUNDLE_SCHEMA)" = "campaignx.vc3d_runtime_bundle.v3" \
 && cd /opt/campaignx/vc3d \
 && sha256sum -c SHA256SUMS \
 && test -x bin/vc_grow_seg_from_seed \
 && test -x bin/vc_mcp_server \
 && test -x bin/vc_render_tifxyz \
 && rm -f /tmp/vc3d-runtime.tgz
WORKDIR /workspace/campaign-x

# Code, CT, m7 volumes and output are supplied as read-only/read-write mounts.
# The only copied payload is the verified VC3D/MCP runtime bundle above.
CMD ["sh"]
