# Copy to base-images.env outside the repository and replace every value with
# a registry reference pinned by sha256.  Tags alone are rejected by Makefile.
# These are examples only; do not treat the placeholder as a real digest.
# VILLA_BASE_IMAGE is the minimal glibc Linux base volume-cartographer compiles
# on, and the floor for anything running its binaries: measured, they ask for
# GLIBC_2.38. There is no VC3D_RUNTIME_CONTEXT any more -- the tools were once
# handed in as a tarball assembled elsewhere, and they are compiled from a
# pinned commit now.
VILLA_BASE_IMAGE=registry.example.org/library/linux-base@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
# Containerfile.gpu-runtime installs exactly one apt package. Without a pin the
# layer floats with the distribution mirror and the image is not
# byte-reproducible. The correct value is a property of the base it installs
# into; read it from that image:
#   docker run --rm "$SURFACE_QC_BASE_IMAGE" sh -c \
#     'apt-get update >/dev/null 2>&1 && apt-cache policy ca-certificates'
# Example for a Debian bookworm base: 20250419
CA_CERTIFICATES_VERSION=REPLACE_WITH_VERSION_FROM_THE_PINNED_BASE
INK_BASE_IMAGE=registry.example.org/campaignx/ink-runtime@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
QC_BASE_IMAGE=registry.example.org/campaignx/qc-runtime@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
ORCHESTRATOR_BASE_IMAGE=registry.example.org/campaignx/orchestrator-runtime@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
# Must contain the runtime libraries matching the separately built native
# bundle (Python ABI, libtiff and OpenMP). Internal research use only.
SCROLLFIESTA_BASE_IMAGE=registry.example.org/campaignx/scrollfiesta-runtime@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
SCROLLFIESTA_RUNTIME_CONTEXT=/absolute/path/to/sterile-scrollfiesta-runtime-context
# `make build-surface-qc` takes a base and two already-built Helena images:
# INK_IMAGE is the frozen six-replica TimeSformer runtime, copied in as
# /opt/conda, and VILLA_IMAGE is the compiled toolchain, from which the
# three-tool bundle is assembled in a stage. Both are validated by digest in
# `check-surface-qc-images`.
#
# SURFACE_QC_BASE_IMAGE is not the ink image, and the difference is not a
# preference: villa's binaries ask for GLIBC_2.38 and the pytorch runtime image
# is 2.35, so basing this on ink builds tools that cannot start. Anything at
# least as new as VILLA_BASE_IMAGE works; the build checks and says so.
SURFACE_QC_BASE_IMAGE=registry.example.org/library/linux-base@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
INK_IMAGE=registry.example.org/campaignx/helena-ink@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
VILLA_IMAGE=registry.example.org/campaignx/helena-villa@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
# build-villa-python and build-ink-9um take a *minimal* base, not a CUDA one.
# uv installs the interpreter and torch into the image, and PyPI's linux torch
# wheels carry their own CUDA runtime as nvidia-* packages -- so the base needs
# glibc, ca-certificates and a python3 for the source-lock check, and nothing
# else. Basing these on an application image instead would inherit a second
# torch and several gigabytes for no gain.
VILLA_PYTHON_BASE_IMAGE=registry.example.org/library/python@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
