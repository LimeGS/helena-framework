[Unit]
# The control plane listens on loopback only; remote workers reach it through
# SSH. That is deliberate: publishing PostgreSQL to the network would expose the
# queue, the leases and every receipt to anything that can route there, and a
# forward restricted to one address, one user and one destination is a much
# smaller door than a firewall rule.
#
# Copy this to /etc/systemd/system/, set User, the identity file and the
# control-plane address below, then enable it.
Description=SSH tunnel to the Helena control plane
Documentation=https://github.com/LimeGS/helena-framework
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=0

[Service]
Type=exec
User=CHANGE_ME
# ExitOnForwardFailure is the point of the whole unit: without it ssh stays up
# with a dead forward, the port answers, and every worker that connects gets a
# reset it cannot explain. With it the process dies and systemd restarts it.
ExecStart=/usr/bin/ssh -N \
  -i /home/CHANGE_ME/.ssh/helena_fleet \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new \
  -L 127.0.0.1:55432:127.0.0.1:55432 \
  CONTROL_PLANE_HOST
Restart=always
RestartSec=5
# A tunnel that flaps should keep trying rather than give up: the far side
# rebooting is a normal Tuesday, not a reason to need a human.

# It forwards a port. It has no business reading the filesystem.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
