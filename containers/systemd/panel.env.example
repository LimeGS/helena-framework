# /etc/helena/panel.env -- root:root 0600.
#
# Read twice: by systemd to expand the mounts, and by the panel as its own
# settings. Every CX_* name is documented in the panel's own Configuration page.

HELENA_PANEL_IMAGE=helena-panel:local
HELENA_PANEL_PORT=8800
# One directory: accounts, settings overrides, their version history, cache.
# The image holds no state, so this is the whole backup.
HELENA_PANEL_STATE=/srv/helena/panel-state
# Missions. Mounted at the same path inside so a path in a record means the same
# thing on the host.
HELENA_PANEL_RUNS=/ssd/campaignx/runs
# Optional extra docker arguments, unbraced in the unit so an empty value adds
# nothing. Today that means the SSH key the Hosts page uses; leave it empty and
# that page reports what it cannot reach instead of guessing.
#   HELENA_PANEL_EXTRA_ARGS=-v /root/.ssh/id_ed25519:/root/.ssh/id_ed25519:ro
HELENA_PANEL_EXTRA_ARGS=

CX_DB=postgresql://REPLACE
CX_RUNS=/ssd/campaignx/runs
CX_FLATTEN_STORE=s3://REPLACE/flattened-v1
CX_RENDER_STORE=s3://REPLACE/layer-stacks-v1
CX_INK_STORE=s3://REPLACE/ink-maps-v1
CX_RECONSTRUCTION_STORE=s3://REPLACE/reconstruction-v1
